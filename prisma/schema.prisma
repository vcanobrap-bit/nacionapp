// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
//  Enums
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  PLAYER
}

enum MatchStatus {
  PENDING      // Por jugar
  IN_PROGRESS  // En curso (partido en vivo)
  FINISHED     // Finalizado
  POSTPONED    // Reagendado (sin fecha confirmada)
}

enum MatchResult {
  WIN
  LOSS
  DRAW
}

/// Estado físico/disponibilidad de la jugadora (solo visible para admin)
enum PlayerStatus {
  AVAILABLE
  INJURED
}

/// Tipo de incidencia en el partido
enum EventType {
  GOAL     // Gol
  AMARILLA // Tarjeta amarilla
  ROJA     // Tarjeta roja
  CAMBIO   // Sustitución
}

// ─────────────────────────────────────────────
//  Models
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(PLAYER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Datos personales de la jugadora (relación 1:1)
  profile   Profile?

  /// Partidos en los que esta jugadora participó
  playerMatches PlayerMatch[]

  /// Partidos creados/administrados por este usuario
  createdMatches Match[] @relation("CreatedBy")

  /// Incidencias de partido donde esta jugadora fue protagonista
  matchEvents  MatchEvent[] @relation("MatchEvents")
  /// Incidencias donde esta jugadora entra (sustituciones)
  matchEvents2 MatchEvent[] @relation("MatchEvents2")

  @@map("users")
}

model Profile {
  id           String       @id @default(cuid())
  userId       String       @unique

  // ── Campos públicos ─────────────────────────
  firstName    String
  lastName     String
  avatarUrl    String?      // URL de la foto de perfil
  birthdate    DateTime?    // Fecha de nacimiento
  joiningYear  Int?         // Año en que se incorporó a la selección
  idealPosition String?     // ej. "Delantera", "Mediocampista", "Defensora", "Portera"
  number       Int?         // Número de camiseta
  bio          String?      // Descripción pública breve

  // ── Campos privados (solo admin) ────────────
  status         PlayerStatus @default(AVAILABLE)
  adminComments  String?      // Notas internas del cuerpo técnico

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Tournament {
  id        String   @id @default(cuid())
  name      String
  year      Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  matches   Match[]
  standings StandingsSnapshot[]

  @@map("tournaments")
}

/// Tabla de posiciones OFICIAL de la asociación, transcrita a mano desde el
/// pantallazo que publica cada ciertas semanas. No se actualiza en vivo.
/// Cada carga es un snapshot completo; la app muestra el más reciente por
/// torneo. Se guarda el historial: permite mostrar movimientos de posición
/// entre publicaciones más adelante.
model StandingsSnapshot {
  id           String   @id @default(cuid())
  tournamentId String
  /// Fecha de la tabla según la asociación (NO cuándo se cargó en la app).
  /// Es lo que se muestra en el disclaimer de "actualizada al".
  asOf         DateTime
  createdAt    DateTime @default(now())

  tournament Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  rows       StandingsRow[]

  @@map("standings_snapshots")
}

/// Una fila de la tabla. La asociación solo publica nombre y puntos
/// acumulados: sin PJ, goles ni otra estadística.
model StandingsRow {
  id         String @id @default(cuid())
  snapshotId String
  /// Puesto en la tabla, ordenada por puntos de mayor a menor
  /// (`sortByPoints`). Empates conservan el orden en que se cargaron.
  position   Int
  teamName   String
  points     Int

  snapshot StandingsSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@map("standings_rows")
}

model Match {
  id        String      @id @default(cuid())
  date      DateTime
  opponent  String      // Nombre del equipo rival
  venue     String?     // Estadio / cancha
  status    MatchStatus @default(PENDING)
  result    MatchResult?          // null mientras status != FINISHED
  homeScore Int?                  // Goles propios
  awayScore Int?                  // Goles del rival
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // ── Fase y reloj del partido en vivo ──────────────────────
  /// Fase dentro de un partido IN_PROGRESS:
  /// PRE (once cargado, calentando) | FIRST_HALF | HALF_TIME | SECOND_HALF
  /// Se guarda como String y no como enum de Postgres: agregar valores a un
  /// enum exige SQL manual en producción (ver gotcha del ALTER TYPE), y las
  /// fases son justamente lo que más probable es que crezca (prórroga, penales).
  phase            String    @default("PRE")
  /// Momento en que arrancó el período actual. null = reloj detenido.
  periodStartedAt  DateTime?
  /// Segundos acumulados al inicio del período actual: 0 en el primer tiempo,
  /// halfMinutes*60 en el segundo (el 2T retoma en 30:00, no en 0 ni en 33).
  clockBaseSeconds Int       @default(0)
  /// Duración de cada tiempo en minutos. 30 en el torneo local.
  halfMinutes      Int       @default(30)

  // ── Torneo / Fixture ──────────────────────────
  tournamentId       String?  // FK a Tournament (opcional)
  round              Int?     // Rueda (1, 2, …) — solo torneos con ruedas
  fixtureRoundNumber Int?     // Número de fecha dentro de la rueda (ej: 5)

  createdById String
  createdBy   User       @relation("CreatedBy", fields: [createdById], references: [id])

  tournament  Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  /// Jugadoras convocadas / que participaron en el partido
  players     PlayerMatch[]

  /// Incidencias del partido (goles, tarjetas)
  events      MatchEvent[]

  @@map("matches")
}

/// Incidencia registrada durante un partido en vivo
model MatchEvent {
  id        String    @id @default(cuid())
  matchId   String
  type      EventType
  /// true = nuestro equipo, false = rival (solo relevante para GOAL)
  isOwn     Boolean   @default(true)
  /// Jugadora principal: autora del gol/tarjeta; o la que Sale en un CAMBIO
  playerId  String?
  /// Solo para CAMBIO: la jugadora que Entra
  player2Id String?
  /// Minuto de juego. null en las incidencias del entretiempo: no ocurren en
  /// un minuto del reloj, y `phase` ya dice cuándo fueron.
  minute    Int?
  /// Fase en que ocurrió: FIRST_HALF | HALF_TIME | SECOND_HALF.
  /// Agrupa la bitácora por tiempo y desambigua el minuto (el 32 puede ser
  /// adición del primer tiempo o minuto 2 del segundo, que arranca en 30).
  phase     String?
  createdAt DateTime  @default(now())

  match   Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player  User? @relation("MatchEvents",  fields: [playerId],  references: [id], onDelete: SetNull)
  player2 User? @relation("MatchEvents2", fields: [player2Id], references: [id], onDelete: SetNull)

  @@map("match_events")
}

/// Tabla intermedia: convocatoria y titularidad por partido
model PlayerMatch {
  id        String  @id @default(cuid())
  userId    String
  matchId   String

  /// true = jugadora titular en este partido (se setea cuando pasa a IN_PROGRESS)
  isTitular Boolean @default(false)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@map("player_matches")
}
